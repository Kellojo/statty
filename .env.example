# Required in production. If unset, a secret is generated and stored at <DATABASE_PATH dir>/.secret (mode 0600).
APP_SECRET=

# Public URL of Statty. Needed behind a reverse proxy and for OAuth (MCP sign-in).
#ORIGIN=https://status.example.com

# Auth
ENABLE_SIGNUP=true
ENABLE_PASSWORD_LOGIN=true
AUTO_PROMOTE_FIRST_USER=true

# OIDC (optional). OIDC_ONLY=true disables password login + sign-up.
#OIDC_ONLY=false
#OIDC_ISSUER=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid profile email

# Docker monitors: the Docker Engine API. unix:///var/run/docker.sock (default on Linux/macOS),
# npipe:////./pipe/docker_engine (Windows), or tcp://host:2375 / https://host:2376.
#DOCKER_HOST=unix:///var/run/docker.sock

# How long check history is kept, in days.
#HEARTBEAT_RETENTION_DAYS=90

# Monitors declared in a YAML file, applied on startup and whenever it changes (see README).
#MONITORS_FILE=/config/statty.yaml
#MONITORS_FILE_POLL_SECONDS=30
